# =============================================================================
# Hotel Yuvaan Frontend — environment templates (Next.js)
# =============================================================================
# Committed files:
#   .env.dev       → remote dev API + Vercel Preview  (npm run dev / build:dev)
#   .env.prod      → production API                   (npm run build / build:prod)
#   .env.localhost → localhost API                    (npm run dev:local)
#
# Personal overrides (gitignored via .env.*.local):
#   .env.localhost.local → optional machine-specific tweaks
#
# Vercel: set NEXT_PUBLIC_* and BACKEND_API_URL / API_VERSION_PATH in dashboard.
# =============================================================================

# NEXT_PUBLIC_APP_ENV=dev
# NEXT_PUBLIC_SITE_URL=https://dev.hotelyuvaan.com
# NEXT_PUBLIC_BACKEND_API_URL=https://dev-api.hotelyuvaan.com
# NEXT_PUBLIC_API_VERSION_PATH=/api/v1.0.0
# BACKEND_API_URL=https://dev-api.hotelyuvaan.com
# API_VERSION_PATH=/api/v1.0.0
